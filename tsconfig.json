{
  "compilerOptions": {
    "baseUrl": "src",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2020",
    "allowJs": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "lib": ["DOM", "ES5", "ES6", "ES7", "ES2020"]
  },
  "include": ["src/**/*.ts"]
}
